# Copy to .env.local and fill in. Never commit .env.local.

# Gemini API key for /api/profile/parse (the demo sentence works without it via the parse cache)
GEMINI_API_KEY=

# Optional, dev only: send agentation toolbar annotations to the local agentation-mcp server (.mcp.json, port 4747)
# NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747
